# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://petmatch:dev@localhost:5432/petmatch

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=change-me-in-production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── API ───────────────────────────────────────────────────────────────────────
API_URL=http://localhost:3001
API_SECRET=change-me-in-production

# ── AI ────────────────────────────────────────────────────────────────────────
# Anthropic (Claude Haiku — chat triage + matching rerank)
ANTHROPIC_API_KEY=

# Voyage AI (embeddings 1024-dim — semantic search)
VOYAGE_API_KEY=

# ── Cloudflare R2 (file uploads) ──────────────────────────────────────────────
# Leave empty in development — uploads are skipped gracefully
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=petmatch
R2_PUBLIC_URL=

# ── Email ─────────────────────────────────────────────────────────────────────
# Development: emails go to Mailpit (http://localhost:8025) via SMTP
# NODE_ENV=development uses SMTP_HOST/SMTP_PORT automatically
SMTP_HOST=localhost
SMTP_PORT=1025

# Production: set RESEND_API_KEY and RESEND_FROM_EMAIL, NODE_ENV=production
RESEND_API_KEY=
RESEND_FROM_EMAIL=PetMatch <noreply@seudominio.com.br>
